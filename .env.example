# Database URL: defaults to local SQLite for zero-configuration development and demo.
# To use hosted Postgres, comment out SQLite and uncomment the Postgres line below:
DATABASE_URL=sqlite:///./secure_vibecode.db
# DATABASE_URL=postgresql+psycopg2://USER:PASSWORD@HOST:5432/DBNAME
#
# --- Supabase Postgres --------------------------------------------------------
# Dashboard -> Settings -> Database -> Connection string. Two URLs, two jobs:
#   - Direct connection (port 5432): run Alembic migrations with this one --
#     `alembic upgrade head` needs a real session, which pgbouncer's transaction
#     pooler below does not provide.
#   - Transaction pooler (port 6543): set DATABASE_URL to this one for the app
#     itself. db.py detects a supabase.co/supabase.com host automatically and
#     adds sslmode=require and skips SQLAlchemy's own pool (pgbouncer already
#     pools upstream, so a second pool on top just wastes pgbouncer slots).
# DATABASE_URL=postgresql+psycopg2://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres
#
# Run migrations against the direct URL, e.g.:
#   DATABASE_URL=postgresql+psycopg2://postgres:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres alembic upgrade head

# Optional: Gemini API key for triage, explanation, and fix prompt generation.
# If unset, deterministic heuristic fallbacks are used.
GEMINI_API_KEY=

# Comma-separated list of frontend origins allowed to call this API via
# CORS. Defaults to the Next.js local dev server if unset. Add the
# deployed Vercel URL here once the frontend is live, e.g.:
# ALLOWED_ORIGINS=https://secure-vibecode.vercel.app,http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Abuse / cost controls (set either to 0 to disable that guard).
# Max scans+rescans a single client IP may start per hour:
SCAN_RATE_LIMIT_PER_HOUR=10
# Hard ceiling on scans+rescans started per UTC day across all users
# (caps LLM spend, since Gemini cost scales with scan count):
DAILY_SCAN_CAP=500

# Optional: Sentry error monitoring. Leave SENTRY_DSN empty to disable.
SENTRY_DSN=
# SENTRY_ENVIRONMENT=production
# SENTRY_TRACES_SAMPLE_RATE=0

# Optional: enables POST /webhooks/github (re-scan on push). Set the same value
# as the "Secret" of a GitHub repo webhook (content type application/json,
# "push" events). Leave empty to keep the endpoint disabled.
GITHUB_WEBHOOK_SECRET=

# Optional sign-in (Supabase Auth). Leave both SUPABASE_JWT_SECRET and
# SUPABASE_JWKS_URL empty to run anonymous-only (everyone uses X-Owner-Token).
#
# Project Settings -> API -> JWT Settings has ONE of these, depending on
# whether the project uses the default shared secret or has "JWT Signing
# Keys" (asymmetric) turned on:
#   - Default (shared secret): put the "JWT Secret" value below.
SUPABASE_JWT_SECRET=
#   - Asymmetric keys enabled: leave SUPABASE_JWT_SECRET empty and use the
#     project's JWKS URL instead (JWKS takes priority if both are set):
# SUPABASE_JWKS_URL=https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json
#
# Project Settings -> API -> Project URL. If set, tokens are also checked
# against the expected issuer ("<SUPABASE_URL>/auth/v1").
# SUPABASE_URL=https://<project-ref>.supabase.co
#
# Only relevant if you front Supabase Auth with a custom OIDC client that
# sets `azp` -- Supabase's own email/password and OAuth tokens don't carry it.
# SUPABASE_AUTHORIZED_PARTIES=https://secure-vibecode.vercel.app,http://localhost:3000

# Set to 1 to enforce plan limits (free: 5 scans/month, no auto re-scan on push,
# 1 org seat). Off by default so demos are never paywalled by accident.
ENFORCE_PLAN_LIMITS=0

# Shared secret for POST /webhooks/billing (HMAC-SHA256, header X-Billing-Signature).
# Leave empty to keep the endpoint disabled.
BILLING_WEBHOOK_SECRET=

# --- Background jobs -------------------------------------------------------
# inline (default): the API runs scans itself. external: the API only queues;
# run `python -m backend.worker` (any number of them) to do the work.
SCAN_WORKER_MODE=inline
# WORKER_CONCURRENCY=2          jobs one worker process runs at once
# JOB_STALE_SECONDS=90          a running job with no heartbeat this long is re-queued
# JOB_HEARTBEAT_SECONDS=15
# JOB_POLL_SECONDS=2

# --- Data retention --------------------------------------------------------
# Delete finished anonymous scans (no account) older than this many days.
# 0 (default) keeps them until the owner deletes them.
ANON_SCAN_RETENTION_DAYS=0

# --- GitHub private repos (optional; needs a GitHub OAuth App) --------------
# Register the app at github.com/settings/developers with callback URL =
# GITHUB_OAUTH_REDIRECT_URI. All four must be set to enable the feature.
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_REDIRECT_URI=
# Encrypts stored GitHub tokens. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Losing or changing it makes stored tokens unreadable (users just reconnect).
TOKEN_ENCRYPTION_KEY=
# Where the browser lands after connecting GitHub (?github=connected|denied|error)
FRONTEND_URL=

# --- Whop billing (optional) -----------------------------------------------
# Signing secret of the Whop webhook endpoint, exactly as Whop shows it (ws_...).
WHOP_WEBHOOK_SECRET=
# Whop plan (or product) ids -> our plans:
# WHOP_PLAN_MAP={"plan_abc123":"pro","prod_xyz789":"team"}

# --- Rate limiting (each value: 0 disables that limit) ------------------------
# db (default): counted in the database, exact across every API instance and
# survives restarts. memory: per-process, resets on restart.
RATE_LIMIT_STORE=db
# OAUTH_RATE_LIMIT_PER_HOUR=30        per IP, GitHub connect flow
# MUTATION_RATE_LIMIT_PER_HOUR=120    per user, org changes and deletions
# WEBHOOK_FAIL_LIMIT_PER_HOUR=30      per IP, deliveries with a bad signature

# --- Admin API (off unless set; use a long random value, 24+ characters) -----
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_API_KEY=
# ADMIN_FAIL_LIMIT_PER_HOUR=10        wrong-key attempts per IP before lockout
# ADMIN_RATE_LIMIT_PER_HOUR=600

# --- Whop checkout (POST /billing/checkout) ----------------------------------
# An API key allowed to create checkout configurations. Leave empty to disable checkout.
WHOP_API_KEY=
# WHOP_API_BASE=https://api.whop.com/api/v1
# CHECKOUT_RATE_LIMIT_PER_HOUR=20      per user

# --- Network safety -----------------------------------------------------------
# Development only: allow scanning private/loopback addresses. NEVER set in production.
# ALLOW_PRIVATE_TARGETS=1

# --- Server-wide GitHub token (OPT-IN; usually leave all of this unset) -------
# A token in GITHUB_TOKEN is IGNORED unless you set ALLOW_SERVER_GITHUB_TOKEN=1,
# because with it on anyone who can submit a URL can scan whatever the token can
# read. If you turn it on, ALWAYS limit it to your own GitHub user/org(s):
# ALLOW_SERVER_GITHUB_TOKEN=1
# SERVER_GITHUB_TOKEN_OWNERS=your-username,your-org
# Users' own connected GitHub accounts (GITHUB_OAUTH_*) are unaffected by this.

# --- Organization invite links -------------------------------------------------
# INVITE_TTL_DAYS=7                    how long a link works (1-60)
# INVITE_RATE_LIMIT_PER_HOUR=30        per IP, previewing/accepting invites

# --- Capacity (see loadtest/README.md) -----------------------------------------
# Scans running at once per API process. Each real scan runs Semgrep (CPU and a few
# hundred MB of RAM), so start near your vCPU count. Throughput is roughly
# SCAN_CONCURRENCY / seconds-per-scan; the rest wait as "queued".
# SCAN_CONCURRENCY=3
# Database connections per process (defaults suit the web server's 40 request threads).
# Keep (SIZE + OVERFLOW) x (API + worker processes) under Postgres max_connections.
# DB_POOL_SIZE=20
# DB_MAX_OVERFLOW=20
# DB_POOL_TIMEOUT=15

